{
  "name": "studiopilot-desktop",
  "productName": "StudioPilot",
  "version": "0.3.2",
  "description": "Desktop chat app for building Roblox games with Claude Code or Codex through StudioPilot.",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder@26.18.0",
    "test": "node test/backend-test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "electron": "^38.4.0"
  },
  "allowScripts": {
    "electron@38.4.0": true
  },
  "build": {
    "appId": "dev.studiopilot.desktop",
    "productName": "StudioPilot",
    "electronVersion": "38.4.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "backend/**",
      "ui/**",
      "package.json",
      "node_modules/marked/**",
      "node_modules/dompurify/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "../bridge",
        "to": "studiopilot/bridge"
      },
      {
        "from": "../plugin",
        "to": "studiopilot/plugin"
      },
      {
        "from": "../blender",
        "to": "studiopilot/blender",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "../agents",
        "to": "studiopilot/agents"
      },
      {
        "from": "../scripts",
        "to": "studiopilot/scripts",
        "filter": [
          "plugin-paths.mjs",
          "install-plugin.mjs",
          "setup.mjs"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "ui/icon-1024.png",
      "executableName": "studiopilot",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "ui/icon-1024.png",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "ui/icon-1024.png",
      "identity": null,
      "artifactName": "StudioPilot-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "build/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StudioPilot-Setup-${version}.${ext}"
    }
  },
  "desktopName": "studiopilot.desktop",
  "author": "StudioPilot"
}
